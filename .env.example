# 岗位实训系统 · 部署环境变量示例
#
# 使用方法：
#   cp .env.example .env
#   编辑 .env，替换所有 CHANGE_ME / 占位值
#
# ⚠️ 安全约定：
#   - 本文件只放「示例占位值」，禁止提交任何真实密码 / API Key / Secret。
#   - 真实值只写入本地 .env（已被 .gitignore 忽略）或部署平台的 Secret 管理。
#   - 生成安全随机值：openssl rand -hex 32

# ============================================================
# 镜像来源
# ============================================================

# 后端镜像。CI（GitHub Actions）已构建推送到 GHCR，直接用这个即可。
IMAGE=ghcr.io/ziruibai/training-system:latest

# ============================================================
# 运行模式
# ============================================================

# development | test | production
# 注意：production 会强制要求 DB_DRIVER=postgres，否则 config 校验直接退出。
APP_ENV=production

# 后端对外暴露端口（宿主机端口 -> 容器 8080）
BACKEND_PORT=8080

# ============================================================
# 数据库（PostgreSQL）
# ============================================================

# sqlite | postgres。生产请用 postgres。
DB_DRIVER=postgres

POSTGRES_USER=training

# 【必填·需替换】数据库密码。示例值仅用于本地试跑，生产务必换成强随机密码。
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

POSTGRES_DB=training

# 宿主机映射的数据库端口（仅绑定 127.0.0.1，不对外暴露）
POSTGRES_PORT=5432

# 数据库连接串。
# - Docker Compose 场景：留空即可，compose 会自动用服务名 postgres 拼装，
#   主机名为 postgres（容器网络内部名），无需你手写。
# - 外部/托管数据库（RDS、云数据库）：取消下一行注释并改成实际地址。
#   ⚠️ .env 文件里不支持 ${VAR} 嵌套展开，请把用户名/密码/库名写成实际字面值。
#   示例：postgres://myuser:mypassword@db.example.com:5432/training?sslmode=require
DB_DSN=

# ============================================================
# 会话
# ============================================================

# 【必填·需替换】会话签名密钥，长度必须 >= 16 字符（config 会校验）。
# 生成方式：openssl rand -hex 32
SESSION_KEY=CHANGE_ME_session_key_at_least_16_chars

# 会话有效期（天）
SESSION_DAYS=7

# ============================================================
# 初始化
# ============================================================

# 一次性初始化开关：
#   true  -> 启动时建表（GORM AutoMigrate）+ 写入演示种子数据（database.Seed，幂等）
#   false -> 只连库不初始化（首次部署完成、数据已就绪后建议改为 false）
# 仅 DB_INIT=true 时才会执行；生产环境默认不自动初始化。
DB_INIT=true

# ============================================================
# 可选：G.AIOS 智能体联动
# ============================================================

# 启用 AI Assistant 聊天与 /api/v1/agent/* 接口时需要。
# 留空则这些接口返回 503，其余功能完全不受影响。
# 【敏感】只写入本地 .env 或平台 Secret，不要提交仓库。
GAIOS_AGENT_API_KEY=